{
    "manifest_version": 3,
    "name": "Enfocador 3000",
    "version": "3.1",
    "description": "Oculta contenido distractor y bloquea sitios durante tus sesiones de estudio (Pomodoro).",

    "permissions": [
        "storage",
        "alarms",
        "notifications"
    ],

    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Enfocador 3000",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "js": [
                "content/common.js",
                "content/youtube.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://www.instagram.com/*"
            ],
            "js": [
                "content/common.js",
                "content/instagram.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://www.facebook.com/*"
            ],
            "js": [
                "content/common.js",
                "content/facebook.js"
            ],
            "run_at": "document_start"
        }
    ]
}
